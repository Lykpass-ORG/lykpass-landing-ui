# Copy to .env.local for development. Never commit real keys.

# Production origin used for canonical URLs, sitemap, hreflang and social cards.
NEXT_PUBLIC_SITE_URL=https://lykpass.com

# Resend (https://resend.com/api-keys). Use a full-access key: contacts are not a sending-only endpoint.
# Without it, development signups are logged and skipped; production signups return an error.
RESEND_API_KEY=

# Optional: the "Waitlist" segment id printed by `npm run resend:setup`.
RESEND_SEGMENT_ID=

# Optional: send a confirmation email to new signups, from a verified Resend domain.
# Example: Lykpass <hello@lykpass.com>
RESEND_FROM_EMAIL=
